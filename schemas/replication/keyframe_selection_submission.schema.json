{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmontage.local/schemas/replication/keyframe_selection_submission.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "request_id",
    "request_sha256",
    "parent_plan_revision",
    "reviewer",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "protocol_version": {
      "const": "representative-selection-v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parent_plan_revision": {
      "type": "string",
      "pattern": "^r[0-9]{4}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ai_coding_assistant",
            "human"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "status",
          "rationale",
          "evidence_refs",
          "information_gaps"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ready",
              "needs_more_evidence",
              "needs_human"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "information_gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "primary_candidate_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "supplementary_anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_id",
                "purpose"
              ],
              "properties": {
                "candidate_id": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "quality_override_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
