{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmontage.local/schemas/replication/keyframe_observation_requests.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "segment_id",
      "request_sha256",
      "target_pts",
      "reason"
    ],
    "properties": {
      "segment_id": {
        "type": "string",
        "minLength": 1
      },
      "request_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "target_pts": {
        "type": "integer"
      },
      "radius_s": {
        "type": "string",
        "pattern": "^[0-9]+(\\.[0-9]+)?$"
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "full_resolution": {
        "type": "boolean",
        "default": false
      }
    }
  }
}
